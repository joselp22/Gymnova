--
-- Name: alimento; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.alimento (
    id_alimento integer NOT NULL,
    nombre_alimento character varying(120) NOT NULL,
    categoria character varying(80),
    descripcion character varying(255),
    porcion_referencia_g numeric(10,2),
    proteinas_g numeric(10,2),
    carbohidratos_g numeric(10,2),
    fibra_g numeric(10,2),
    CONSTRAINT alimento_carbohidratos_g_check CHECK (((carbohidratos_g IS NULL) OR (carbohidratos_g >= (0)::numeric))),
    CONSTRAINT alimento_fibra_g_check CHECK (((fibra_g IS NULL) OR (fibra_g >= (0)::numeric))),
    CONSTRAINT alimento_porcion_referencia_g_check CHECK (((porcion_referencia_g IS NULL) OR (porcion_referencia_g > (0)::numeric))),
    CONSTRAINT alimento_proteinas_g_check CHECK (((proteinas_g IS NULL) OR (proteinas_g >= (0)::numeric))),
    CONSTRAINT ck_alimento_nombre_no_vacio CHECK ((btrim((nombre_alimento)::text) <> ''::text))
);


ALTER TABLE public.alimento OWNER TO postgres;

--
-- Name: alimento_alergeno; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.alimento_alergeno (
    id_alimento integer NOT NULL,
    alergeno character varying(150) NOT NULL,
    CONSTRAINT ck_alimento_alergeno_nombre CHECK ((btrim((alergeno)::text) <> ''::text))
);


ALTER TABLE public.alimento_alergeno OWNER TO postgres;

--
-- Name: alimento_id_alimento_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.alimento ALTER COLUMN id_alimento ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.alimento_id_alimento_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: aplica_descuento; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.aplica_descuento (
    id_factura bigint NOT NULL,
    id_descuento integer NOT NULL,
    fecha_aplicacion date DEFAULT CURRENT_DATE NOT NULL,
    base_calculo numeric(10,2) NOT NULL,
    motivo_aplicacion character varying(150),
    estado_aplicacion character varying(30) DEFAULT 'APLICADO'::character varying NOT NULL,
    CONSTRAINT ck_aplica_descuento_base_calculo CHECK ((base_calculo >= (0)::numeric)),
    CONSTRAINT ck_aplica_descuento_estado CHECK (((estado_aplicacion)::text = ANY ((ARRAY['APLICADO'::character varying, 'ANULADO'::character varying, 'PENDIENTE'::character varying])::text[]))),
    CONSTRAINT ck_aplica_descuento_fecha CHECK ((fecha_aplicacion <= CURRENT_DATE)),
    CONSTRAINT ck_aplica_descuento_motivo CHECK (((motivo_aplicacion IS NULL) OR (btrim((motivo_aplicacion)::text) <> ''::text)))
);


ALTER TABLE public.aplica_descuento OWNER TO postgres;

--
-- Name: asignacion_rutina; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.asignacion_rutina (
    id_asignacion bigint NOT NULL,
    fecha_asignacion date DEFAULT CURRENT_DATE NOT NULL,
    fecha_inicio date NOT NULL,
    fecha_fin date,
    estado_asignacion character varying(30) DEFAULT 'ACTIVA'::character varying NOT NULL,
    motivo_finalizacion text,
    observaciones text,
    id_cliente bigint NOT NULL,
    id_rutina bigint NOT NULL,
    CONSTRAINT ck_asignacion_rutina_estado CHECK (((estado_asignacion)::text = ANY ((ARRAY['ACTIVA'::character varying, 'FINALIZADA'::character varying, 'PAUSADA'::character varying, 'CANCELADA'::character varying])::text[]))),
    CONSTRAINT ck_asignacion_rutina_fecha_asignacion CHECK ((fecha_asignacion <= fecha_inicio)),
    CONSTRAINT ck_asignacion_rutina_fechas CHECK (((fecha_fin IS NULL) OR (fecha_fin >= fecha_inicio))),
    CONSTRAINT ck_asignacion_rutina_motivo_finalizacion CHECK ((((estado_asignacion)::text <> 'FINALIZADA'::text) OR (motivo_finalizacion IS NOT NULL)))
);


ALTER TABLE public.asignacion_rutina OWNER TO postgres;

--
-- Name: asignacion_rutina_id_asignacion_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.asignacion_rutina ALTER COLUMN id_asignacion ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.asignacion_rutina_id_asignacion_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: asistencia; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.asistencia (
    id_asistencia bigint NOT NULL,
    fecha_asistencia date DEFAULT CURRENT_DATE NOT NULL,
    hora_entrada time without time zone NOT NULL,
    hora_salida time without time zone,
    tipo_acceso character varying(50) NOT NULL,
    metodo_registro character varying(50) NOT NULL,
    estado_acceso character varying(30) DEFAULT 'REGISTRADO'::character varying NOT NULL,
    observaciones text,
    id_cliente bigint NOT NULL,
    CONSTRAINT ck_asistencia_estado_acceso CHECK (((estado_acceso)::text = ANY ((ARRAY['REGISTRADO'::character varying, 'COMPLETADO'::character varying, 'ANULADO'::character varying])::text[]))),
    CONSTRAINT ck_asistencia_horas CHECK (((hora_salida IS NULL) OR (hora_salida >= hora_entrada))),
    CONSTRAINT ck_asistencia_metodo_registro CHECK (((metodo_registro)::text = ANY ((ARRAY['QR'::character varying, 'CEDULA'::character varying, 'MANUAL'::character varying, 'BIOMETRICO'::character varying])::text[]))),
    CONSTRAINT ck_asistencia_tipo_acceso CHECK (((tipo_acceso)::text = ANY ((ARRAY['MEMBRESIA'::character varying, 'RESERVA'::character varying, 'INVITADO'::character varying, 'MANUAL'::character varying])::text[])))
);


ALTER TABLE public.asistencia OWNER TO postgres;

--
-- Name: asistencia_id_asistencia_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.asistencia ALTER COLUMN id_asistencia ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.asistencia_id_asistencia_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: bitacora; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.bitacora (
    id_bitacora bigint NOT NULL,
    id_usuario bigint NOT NULL,
    fecha_hora timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    accion_realizada character varying(150) NOT NULL,
    modulo character varying(100) NOT NULL,
    direccion_ip character varying(45),
    descripcion text,
    resultado text,
    CONSTRAINT ck_bitacora_accion_realizada CHECK ((btrim((accion_realizada)::text) <> ''::text)),
    CONSTRAINT ck_bitacora_direccion_ip CHECK (((direccion_ip IS NULL) OR ((length(btrim((direccion_ip)::text)) >= 3) AND (length(btrim((direccion_ip)::text)) <= 45)))),
    CONSTRAINT ck_bitacora_modulo CHECK ((btrim((modulo)::text) <> ''::text))
);


ALTER TABLE public.bitacora OWNER TO postgres;

--
-- Name: bitacora_id_bitacora_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.bitacora ALTER COLUMN id_bitacora ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.bitacora_id_bitacora_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


