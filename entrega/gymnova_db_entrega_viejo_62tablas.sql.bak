    id_reserva bigint NOT NULL,
    codigo_reserva character varying(50) NOT NULL,
    fecha_hora_reserva timestamp without time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    estado_reserva character varying(30) DEFAULT 'ACTIVA'::character varying NOT NULL,
    fecha_hora_cancelacion timestamp without time zone,
    motivo_cancelacion text,
    asistencia_confirmada boolean DEFAULT false NOT NULL,
    observaciones text,
    id_cliente bigint NOT NULL,
    id_horario integer NOT NULL,
    CONSTRAINT chk_reserva_codigo_formato CHECK (((codigo_reserva)::text ~ '^RS[0-9]{5}$'::text)),
    CONSTRAINT ck_reserva_cancelacion_fecha CHECK (((fecha_hora_cancelacion IS NULL) OR (fecha_hora_cancelacion >= fecha_hora_reserva))),
    CONSTRAINT ck_reserva_cancelacion_motivo CHECK ((((estado_reserva)::text <> 'CANCELADA'::text) OR (motivo_cancelacion IS NOT NULL))),
    CONSTRAINT ck_reserva_codigo CHECK ((btrim((codigo_reserva)::text) <> ''::text)),
    CONSTRAINT ck_reserva_estado CHECK (((estado_reserva)::text = ANY ((ARRAY['ACTIVA'::character varying, 'CANCELADA'::character varying, 'ASISTIDA'::character varying, 'NO_ASISTIDA'::character varying])::text[])))
);


ALTER TABLE public.reserva OWNER TO postgres;

