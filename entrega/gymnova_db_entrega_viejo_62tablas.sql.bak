    costo_mano_obra numeric(10,2) DEFAULT 0 NOT NULL,
    resultado_mantenimiento text,
    descripcion_falla text,
    trabajo_realizado text,
    estado_mantenimiento character varying(30) DEFAULT 'SOLICITADO'::character varying NOT NULL,
    observaciones text,
    id_equipo bigint NOT NULL,
    id_tipo_mantenimiento integer NOT NULL,
    id_empleado bigint NOT NULL,
    CONSTRAINT ck_mantenimiento_costo_mano_obra CHECK ((costo_mano_obra >= (0)::numeric)),
    CONSTRAINT ck_mantenimiento_costo_repuestos CHECK ((costo_repuestos >= (0)::numeric)),
    CONSTRAINT ck_mantenimiento_estado CHECK (((estado_mantenimiento)::text = ANY ((ARRAY['SOLICITADO'::character varying, 'PROGRAMADO'::character varying, 'REALIZADO'::character varying, 'CANCELADO'::character varying, 'PENDIENTE'::character varying])::text[]))),
    CONSTRAINT ck_mantenimiento_fecha_programada CHECK (((fecha_programada IS NULL) OR (fecha_programada >= fecha_solicitud))),
    CONSTRAINT ck_mantenimiento_fecha_realizacion CHECK (((fecha_realizacion IS NULL) OR (fecha_programada IS NULL) OR (fecha_realizacion >= fecha_programada))),
    CONSTRAINT ck_mantenimiento_fecha_solicitud CHECK ((fecha_solicitud <= CURRENT_DATE)),
    CONSTRAINT ck_mantenimiento_numero_mantenimiento CHECK ((btrim((numero_mantenimiento)::text) <> ''::text))
);


