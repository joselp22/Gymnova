--
-- Name: comprobante; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.comprobante (
    id_comprobante bigint NOT NULL,
    numero_comprobante character varying(50) NOT NULL,
    tipo_comprobante character varying(150) NOT NULL,
    fecha_emision date DEFAULT CURRENT_DATE NOT NULL,
    formato_archivo character varying(150),
    ruta_archivo character varying(500),
    correo_envio character varying(150),
    fecha_envio date,
    estado_comprobante character varying(30) DEFAULT 'GENERADO'::character varying NOT NULL,
    id_pago bigint NOT NULL,
    CONSTRAINT ck_comprobante_correo_envio CHECK (((correo_envio IS NULL) OR ((correo_envio)::text ~* '^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$'::text))),
    CONSTRAINT ck_comprobante_estado CHECK (((estado_comprobante)::text = ANY ((ARRAY['GENERADO'::character varying, 'ENVIADO'::character varying, 'ANULADO'::character varying, 'ERROR'::character varying])::text[]))),
    CONSTRAINT ck_comprobante_fecha_emision CHECK ((fecha_emision <= CURRENT_DATE)),
    CONSTRAINT ck_comprobante_fecha_envio CHECK (((fecha_envio IS NULL) OR (fecha_envio >= fecha_emision))),
    CONSTRAINT ck_comprobante_formato_archivo CHECK (((formato_archivo IS NULL) OR (btrim((formato_archivo)::text) <> ''::text))),
    CONSTRAINT ck_comprobante_numero_comprobante CHECK ((btrim((numero_comprobante)::text) <> ''::text)),
    CONSTRAINT ck_comprobante_ruta_archivo CHECK (((ruta_archivo IS NULL) OR (btrim((ruta_archivo)::text) <> ''::text))),
    CONSTRAINT ck_comprobante_tipo_comprobante CHECK ((btrim((tipo_comprobante)::text) <> ''::text))
);


ALTER TABLE public.comprobante OWNER TO postgres;

--
-- Name: comprobante_id_comprobante_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.comprobante ALTER COLUMN id_comprobante ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.comprobante_id_comprobante_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: congelacion; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.congelacion (
    id_congelacion bigint NOT NULL,
    fecha_solicitud date DEFAULT CURRENT_DATE NOT NULL,
    fecha_inicio date NOT NULL,
    fecha_fin date NOT NULL,
    motivo text NOT NULL,
    observaciones text,
    estado_congelacion character varying(30) DEFAULT 'SOLICITADA'::character varying NOT NULL,
    id_membresia bigint NOT NULL,
    CONSTRAINT ck_congelacion_estado CHECK (((estado_congelacion)::text = ANY ((ARRAY['SOLICITADA'::character varying, 'APROBADA'::character varying, 'RECHAZADA'::character varying, 'ACTIVA'::character varying, 'FINALIZADA'::character varying, 'CANCELADA'::character varying])::text[]))),
    CONSTRAINT ck_congelacion_fechas CHECK ((fecha_fin >= fecha_inicio)),
    CONSTRAINT ck_congelacion_motivo CHECK ((btrim(motivo) <> ''::text))
);


ALTER TABLE public.congelacion OWNER TO postgres;

--
-- Name: congelacion_id_congelacion_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.congelacion ALTER COLUMN id_congelacion ADD GENERATED ALWAYS AS IDENTITY (
    SEQUENCE NAME public.congelacion_id_congelacion_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: contiene_ejercicio; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.contiene_ejercicio (
    id_rutina_ejercicio bigint NOT NULL,
    dia_semana character varying(15) NOT NULL,
    orden integer NOT NULL,
    series integer NOT NULL,
    repeticiones character varying(50) NOT NULL,
    peso_sugerido numeric(6,2),
    duracion_minutos integer,
    descanso_segundos integer,
    id_rutina bigint NOT NULL,
    id_ejercicio integer NOT NULL,
    CONSTRAINT ck_contiene_ejercicio_descanso CHECK (((descanso_segundos IS NULL) OR (descanso_segundos >= 0))),
