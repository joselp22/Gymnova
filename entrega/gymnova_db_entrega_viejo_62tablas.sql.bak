--
-- Name: cliente; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.cliente (
    id_persona bigint NOT NULL,
    codigo_cliente character varying(20) NOT NULL,
    fecha_registro date DEFAULT CURRENT_DATE NOT NULL,
    peso_inicial numeric(5,2) NOT NULL,
    peso_meta numeric(5,2) NOT NULL,
    observaciones character varying(500),
    estado_cliente boolean DEFAULT true NOT NULL,
    CONSTRAINT chk_cliente_codigo_formato CHECK (((codigo_cliente)::text ~ '^CL[0-9]{5}$'::text)),
    CONSTRAINT ck_cliente_codigo_cliente_no_vacio CHECK ((btrim((codigo_cliente)::text) <> ''::text)),
    CONSTRAINT ck_cliente_fecha_registro CHECK ((fecha_registro <= CURRENT_DATE)),
    CONSTRAINT ck_cliente_peso_inicial CHECK ((peso_inicial > (0)::numeric)),
    CONSTRAINT ck_cliente_peso_meta CHECK ((peso_meta > (0)::numeric))
);


ALTER TABLE public.cliente OWNER TO postgres;

--
-- Name: cliente_objetivo; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.cliente_objetivo (
    id_cliente_objetivo bigint NOT NULL,
    fecha_inicio date DEFAULT CURRENT_DATE NOT NULL,
    fecha_meta date,
    prioridad character varying(30) DEFAULT 'MEDIA'::character varying NOT NULL,
    estado_cliente_objetivo character varying(30) DEFAULT 'ACTIVO'::character varying NOT NULL,
    observaciones text,
    peso_actual numeric(5,2),
    id_cliente bigint NOT NULL,
    id_objetivo integer NOT NULL,
    CONSTRAINT ck_cliente_objetivo_estado CHECK (((estado_cliente_objetivo)::text = ANY ((ARRAY['ACTIVO'::character varying, 'CUMPLIDO'::character varying, 'PAUSADO'::character varying, 'CANCELADO'::character varying])::text[]))),
    CONSTRAINT ck_cliente_objetivo_fechas CHECK (((fecha_meta IS NULL) OR (fecha_meta >= fecha_inicio))),
    CONSTRAINT ck_cliente_objetivo_peso_actual CHECK (((peso_actual IS NULL) OR (peso_actual > (0)::numeric))),
    CONSTRAINT ck_cliente_objetivo_prioridad CHECK (((prioridad)::text = ANY ((ARRAY['BAJA'::character varying, 'MEDIA'::character varying, 'ALTA'::character varying])::text[])))
);


ALTER TABLE public.cliente_objetivo OWNER TO postgres;

--
-- Name: cliente_objetivo_id_cliente_objetivo_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

