    SEQUENCE NAME public.cliente_objetivo_id_cliente_objetivo_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: compra; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.compra (
    id_compra bigint NOT NULL,
    numero_compra character varying(50) NOT NULL,
    numero_factura_proveedor character varying(50),
    fecha_compra date DEFAULT CURRENT_DATE NOT NULL,
    fecha_recepcion date,
    tipo_pago character varying(50) NOT NULL,
    estado_compra character varying(30) DEFAULT 'REGISTRADA'::character varying NOT NULL,
    observaciones text,
    id_proveedor integer NOT NULL,
    id_empleado bigint NOT NULL,
    CONSTRAINT ck_compra_estado_compra CHECK (((estado_compra)::text = ANY ((ARRAY['REGISTRADA'::character varying, 'RECIBIDA'::character varying, 'ANULADA'::character varying, 'PENDIENTE'::character varying])::text[]))),
    CONSTRAINT ck_compra_fecha_compra CHECK ((fecha_compra <= CURRENT_DATE)),
    CONSTRAINT ck_compra_fecha_recepcion CHECK (((fecha_recepcion IS NULL) OR (fecha_recepcion >= fecha_compra))),
    CONSTRAINT ck_compra_numero_compra CHECK ((btrim((numero_compra)::text) <> ''::text)),
    CONSTRAINT ck_compra_numero_factura_proveedor CHECK (((numero_factura_proveedor IS NULL) OR (btrim((numero_factura_proveedor)::text) <> ''::text))),
    CONSTRAINT ck_compra_tipo_pago CHECK (((tipo_pago)::text = ANY ((ARRAY['EFECTIVO'::character varying, 'TRANSFERENCIA'::character varying, 'TARJETA'::character varying, 'CREDITO'::character varying, 'OTRO'::character varying])::text[])))
);


ALTER TABLE public.compra OWNER TO postgres;

