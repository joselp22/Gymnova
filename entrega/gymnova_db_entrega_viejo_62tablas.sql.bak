    estado_rutina character varying(30) DEFAULT 'ACTIVA'::character varying NOT NULL,
    id_entrenador bigint NOT NULL,
    id_objetivo integer NOT NULL,
    CONSTRAINT ck_rutina_duracion CHECK ((duracion_semanas > 0)),
    CONSTRAINT ck_rutina_estado CHECK (((estado_rutina)::text = ANY ((ARRAY['ACTIVA'::character varying, 'INACTIVA'::character varying, 'ARCHIVADA'::character varying])::text[]))),
    CONSTRAINT ck_rutina_fecha_creacion CHECK ((fecha_creacion <= CURRENT_DATE)),
    CONSTRAINT ck_rutina_nivel CHECK (((nivel)::text = ANY ((ARRAY['PRINCIPIANTE'::character varying, 'INTERMEDIO'::character varying, 'AVANZADO'::character varying])::text[]))),
    CONSTRAINT ck_rutina_nombre CHECK ((btrim((nombre_rutina)::text) <> ''::text))
);


