    CONSTRAINT ck_suministra_producto_cantidad_minima CHECK (((cantidad_minima_pedido IS NULL) OR (cantidad_minima_pedido > 0))),
    CONSTRAINT ck_suministra_producto_codigo CHECK (((codigo_producto_proveedor IS NULL) OR (btrim((codigo_producto_proveedor)::text) <> ''::text))),
    CONSTRAINT ck_suministra_producto_costo_referencia CHECK (((costo_referencia IS NULL) OR (costo_referencia >= (0)::numeric))),
    CONSTRAINT ck_suministra_producto_fecha_actualizacion CHECK ((fecha_actualizacion <= CURRENT_DATE)),
    CONSTRAINT ck_suministra_producto_tiempo_entrega CHECK (((tiempo_entrega_dias IS NULL) OR (tiempo_entrega_dias >= 0)))
);


