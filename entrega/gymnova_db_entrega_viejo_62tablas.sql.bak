    CONSTRAINT ck_clase_grupal_nombre_no_vacio CHECK ((btrim((nombre_clase)::text) <> ''::text)),
    CONSTRAINT clase_grupal_duracion_base_minutos_check CHECK ((duracion_base_minutos > 0))
);


